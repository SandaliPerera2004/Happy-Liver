rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USER DATA
    // ============================================================

    match /users/{userId} {

      // User profile
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;


      // ==========================================================
      // DIET RECORDS
      // Path:
      // users/{userId}/diets/{dietId}
      // ==========================================================

      match /diets/{dietId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // WORKOUT RECORDS
      // Path:
      // users/{userId}/workouts/{workoutId}
      // ==========================================================

      match /workouts/{workoutId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // ASSESSMENT RECORDS
      // Path:
      // users/{userId}/assessments/{assessmentId}
      // ==========================================================

      match /assessments/{assessmentId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // FEEDBACK RECORDS
      // Path:
      // users/{userId}/feedback/{feedbackId}
      // ==========================================================

      match /feedback/{feedbackId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // PROBLEM REPORTS
      // Path:
      // users/{userId}/reports/{reportId}
      // ==========================================================

      match /reports/{reportId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }


      // ==========================================================
      // WORKOUT PROGRESS
      // Path:
      // users/{userId}/workoutProgress/{date}/workouts/{workoutId}
      // ==========================================================

      match /workoutProgress/{date}/workouts/{workoutId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }


    // ============================================================
    // WORKOUT PLANS
    // Path:
    // workoutPlans/{riskLevel}/exercises/{exerciseId}
    // ============================================================

    match /workoutPlans/{riskLevel}/exercises/{exerciseId} {
      allow read:
        if request.auth != null;
    }


    // ============================================================
    // GLOBAL FEEDBACK
    // Path:
    // feedback/{feedbackId}
    // ============================================================

    match /feedback/{feedbackId} {
      allow create, read:
        if request.auth != null;
    }
  }
}